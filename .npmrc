# Required while this project is on TypeScript 7: typescript-eslint 8.x
# peer-requires typescript ">=4.8.4 <6.1.0", so npm cannot resolve the tree
# without ignoring peer ranges. eslint-plugin-react and eslint-plugin-import
# likewise cap at ESLint 9 while we are on ESLint 10.
#
# Trade-off: this also suppresses the peer conflicts that would otherwise make
# an incompatible dependabot major fail loudly at install time. Remove this
# once typescript-eslint supports TS >=7.1 and the ESLint 10 plugin releases
# land, then re-enable lint (see eslint.config.mjs).
legacy-peer-deps=true
